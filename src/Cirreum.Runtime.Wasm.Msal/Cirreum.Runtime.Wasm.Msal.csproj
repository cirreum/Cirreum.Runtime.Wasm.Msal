<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<RootNamespace>Cirreum.Runtime</RootNamespace>
		<Description>The Runtime Library for Clients that supports Msal Authentication.</Description>
		<PackageTags>cirreum;authentication;client;msal</PackageTags>
	</PropertyGroup>

	<!-- InternalsVisibleTo: Local Development Only -->
	<ItemGroup Label="InternalsVisibleTo" Condition="'$(IsLocalBuild)' == 'true'">
		<InternalsVisibleTo Include="$(AssemblyName).Tests" />
	</ItemGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Authentication.WebAssembly.Msal" Version="10.0.10" />
		<PackageReference Include="Cirreum.Graph.Provider" Version="1.0.63" />
		<PackageReference Include="Cirreum.Runtime.Wasm" Version="2.0.0" />
	</ItemGroup>

</Project>